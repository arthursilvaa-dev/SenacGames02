@model SenacGames.UI.Models.ErrorViewModel

<h1 class="text-danger">Erro</h1>
<p>Ocorreu um erro no processamento da sua solicitação.</p>

@if (Model?.ShowRequestId ?? false)
{
    <p>
        <strong>Request ID:</strong> @Model.RequestId
    </p>
}


<h3>Modo de Desenvolvimento</h3>
<p>
    Trocar para o ambiente de <strong>Desenvolvimento</strong> exibirá informações mais detalhadas sobre o erro que ocorreu.
</p>
<p>
    <strong>O ambiente de Desenvolvimento não deve ser habilitado para aplicações implantadas.</strong>
    Isso pode resultar na exibição de informações sensíveis de exceções para usuários finais.
    Para depuração local, habilite o ambiente de <strong>Desenvolvimento</strong> definindo a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Desenvolvimento</strong>
    e reiniciando o aplicativo.
</p>
